generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  HOUSEKEEPER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MTN_MOBILE_MONEY
  AIRTEL_MONEY
  ZAMTEL_KWACHA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DailyCloseStatus {
  SUBMITTED
  APPROVED
  REOPENED
}

model Property {
  id            String         @id @default(cuid())
  name          String
  type          String         @default("LODGE")
  address       String
  town          String
  province      String
  phone         String
  email         String?
  tpin          String?
  currency      String         @default("ZMW")
  users         User[]
  roomTypes     RoomType[]
  rooms         Room[]
  bookings      Booking[]
  expenses      Expense[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  guests        Guest[]
  notifications Notification[]
  dailyCloses   DailyClose[]
}

model User {
  id                  String         @id @default(cuid())
  firstName           String
  lastName            String
  email               String         @unique
  phone               String?
  passwordHash        String
  role                UserRole       @default(RECEPTIONIST)
  isActive            Boolean        @default(true)
  propertyId          String
  property            Property       @relation(fields: [propertyId], references: [id])
  auditLogs           AuditLog[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  notifications       Notification[]
  preparedDailyCloses DailyClose[]   @relation("DailyClosePreparedBy")
  approvedDailyCloses DailyClose[]   @relation("DailyCloseApprovedBy")
  reopenedDailyCloses DailyClose[]   @relation("DailyCloseReopenedBy")
}

model RoomType {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int      @default(2)
  basePrice   Decimal  @db.Decimal(12, 2)
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, name])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String
  floor      String?
  status     RoomStatus @default(AVAILABLE)
  notes      String?
  propertyId String
  roomTypeId String
  property   Property   @relation(fields: [propertyId], references: [id])
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([propertyId, roomNumber])
}

model Guest {
  id            String  @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String
  nationality   String  @default("Zambian")
  nrcOrPassport String?
  address       String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([phone])
  @@index([nrcOrPassport])
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  checkInDate   DateTime
  checkOutDate  DateTime
  adults        Int           @default(1)
  children      Int           @default(0)
  status        BookingStatus @default(PENDING)
  source        String        @default("WALK_IN")
  totalAmount   Decimal       @db.Decimal(12, 2)
  notes         String?
  guestId       String
  roomId        String
  propertyId    String
  guest         Guest         @relation(fields: [guestId], references: [id])
  room          Room          @relation(fields: [roomId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([propertyId, checkInDate, checkOutDate])
  @@index([roomId, status])
}

model Payment {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  transactionId String?
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  refundedAt    DateTime?
}

model Expense {
  id            String        @id @default(cuid())
  category      String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  expenseDate   DateTime      @default(now())
  propertyId    String
  property      Property      @relation(fields: [propertyId], references: [id])
  createdAt     DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetCode {
  id             String    @id @default(cuid())
  email          String
  codeHash       String
  resetTokenHash String?
  expiresAt      DateTime
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email, createdAt])
  @@index([resetTokenHash])
}

model Notification {
  id         String    @id @default(cuid())
  type       String
  priority   String    @default("NORMAL")
  title      String
  message    String
  link       String?
  dedupeKey  String
  readAt     DateTime?
  userId     String
  propertyId String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([propertyId, createdAt])
}

model DailyClose {
  id                 String           @id @default(cuid())
  businessDate       DateTime         @db.Date
  status             DailyCloseStatus @default(SUBMITTED)
  cashAmount         Decimal          @db.Decimal(14, 2)
  cardAmount         Decimal          @db.Decimal(14, 2)
  bankTransferAmount Decimal          @db.Decimal(14, 2)
  mtnAmount          Decimal          @db.Decimal(14, 2)
  airtelAmount       Decimal          @db.Decimal(14, 2)
  zamtelAmount       Decimal          @db.Decimal(14, 2)
  refundAmount       Decimal          @db.Decimal(14, 2)
  grossAmount        Decimal          @db.Decimal(14, 2)
  expenseAmount      Decimal          @db.Decimal(14, 2)
  netAmount          Decimal          @db.Decimal(14, 2)
  expectedCash       Decimal          @db.Decimal(14, 2)
  countedCash        Decimal          @db.Decimal(14, 2)
  cashVariance       Decimal          @db.Decimal(14, 2)
  transactionCount   Int
  notes              String?
  propertyId         String
  preparedById       String
  approvedById       String?
  reopenedById       String?
  preparedAt         DateTime         @default(now())
  approvedAt         DateTime?
  reopenedAt         DateTime?
  updatedAt          DateTime         @updatedAt
  property           Property         @relation(fields: [propertyId], references: [id])
  preparedBy         User             @relation("DailyClosePreparedBy", fields: [preparedById], references: [id])
  approvedBy         User?            @relation("DailyCloseApprovedBy", fields: [approvedById], references: [id])
  reopenedBy         User?            @relation("DailyCloseReopenedBy", fields: [reopenedById], references: [id])

  @@unique([propertyId, businessDate])
  @@index([propertyId, status, businessDate])
}
